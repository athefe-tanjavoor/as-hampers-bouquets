# Server & Application Environment
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000

# Storefront & Admin URLs
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/bouquet_hamper_db

# JWT & Authentication Secrets
JWT_SECRET=super_secret_jwt_key_bloom_blossom_2026_production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=super_secret_refresh_key_bloom_blossom_2026
REFRESH_TOKEN_EXPIRES_IN=30d

# Razorpay Payment Gateway (Test / Live credentials)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_verification_key

# Cloudflare R2 / S3-Compatible Storage
R2_ACCOUNT_ID=cloudflare_r2_account_id_placeholder
R2_ACCESS_KEY_ID=cloudflare_r2_access_key_placeholder
R2_SECRET_ACCESS_KEY=cloudflare_r2_secret_key_placeholder
R2_BUCKET_NAME=bouquet-hamper-media
R2_PUBLIC_URL=https://media.bloomandblossom.com

# Email Service (Resend / Amazon SES)
RESEND_API_KEY=re_placeholder_resend_api_key
EMAIL_FROM="Bloom & Blossom <orders@bloomandblossom.com>"
SUPPORT_EMAIL=hello@bloomandblossom.com

# Analytics & Marketing Tracking
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=123456789012345
